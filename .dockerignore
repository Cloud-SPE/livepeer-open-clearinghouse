.git
.github
.gitignore
.dockerignore
.env
.env.*
!.env.example
.dev

# Python
__pycache__
*.py[cod]
*.egg-info
*.so
.venv
.python-version
.pytest_cache
.mypy_cache
.ruff_cache
.coverage
.coverage.*
htmlcov

# Node
node_modules
*.log

# IDE / OS
.idea
.vscode
.DS_Store
Thumbs.db

# Tests not needed in the runtime image
tests

# Build artifacts
build
dist
*.egg

# Docs not needed at runtime — keep image lean
docs

# Build-context exclusions
Makefile
scripts

# LICENSE + README.md are NOT excluded — the builder stage needs them
# because pyproject.toml references both via `license = { file = "LICENSE" }`
# and `readme = "README.md"`. The runtime stage doesn't COPY them, so
# they don't end up in the final image.
