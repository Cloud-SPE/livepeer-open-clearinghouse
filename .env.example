# Livepeer Open Clearinghouse environment configuration.
#
# Copy this file to `.env` for local development. `.env` is git-ignored.
# Values marked "MUST CHANGE FOR PROD" are dev-only placeholders.

# ---------------------------------------------------------------------------
# application
# ---------------------------------------------------------------------------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# database
# ---------------------------------------------------------------------------
# docker compose uses the service name `db` as host
DATABASE_URL=postgresql+asyncpg://livepeer_open_clearinghouse:livepeer_open_clearinghouse-dev-password@db:5432/livepeer_open_clearinghouse

POSTGRES_DB=livepeer_open_clearinghouse
POSTGRES_USER=livepeer_open_clearinghouse
POSTGRES_PASSWORD=livepeer_open_clearinghouse-dev-password

# ---------------------------------------------------------------------------
# secrets — MUST CHANGE FOR PROD
# ---------------------------------------------------------------------------
API_KEY_HASH_PEPPER=dev-pepper-CHANGE-FOR-PROD
SESSION_SECRET=dev-session-secret-CHANGE-FOR-PROD
METRICS_TOKEN=dev-metrics-token-CHANGE-FOR-PROD
ADMIN_BOOTSTRAP_TOKEN=dev-admin-bootstrap-CHANGE-FOR-PROD

# ---------------------------------------------------------------------------
# OAuth (optional — deferred to a later phase)
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# email
# ---------------------------------------------------------------------------
# EMAIL_PROVIDER:
#   auto    — Resend if RESEND_API_KEY set, else NullEmail (default)
#   null    — force NullEmail (logs the message body, never sends)
#   resend  — force Resend; fails to boot if RESEND_API_KEY is missing
EMAIL_PROVIDER=auto
# RESEND_API_KEY=re_...
# RESEND_API_URL overrides the SDK's default https://api.resend.com.
# Set this only if you're using a regional Resend endpoint, an on-prem
# Resend-compatible proxy, or a recording mock in tests.
# RESEND_API_URL=https://api.resend.com
# RESEND_WEBHOOK_SECRET enables POST /v1/webhooks/resend. Copy the
# `whsec_…` signing secret from Resend's dashboard per-webhook. If
# unset, the endpoint returns 503.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM_ADDRESS=no-reply@livepeer-open-clearinghouse.local
EMAIL_FROM_NAME=Livepeer Open Clearinghouse

# ---------------------------------------------------------------------------
# daemons — UDS paths inside the gateway container (shared volume)
# ---------------------------------------------------------------------------
# Arbitrum One JSON-RPC endpoint used by BOTH daemons. Public default
# is rate-limited; for any real workload use Alchemy/Infura/your own.
CHAIN_RPC=https://arb1.arbitrum.io/rpc
# Path on the host that contains keystore.json + keystore-password.
# Mounted read-only into payment-daemon at /etc/livepeer. Run
# `make dev-keystore` to generate one, or drop in your own.
LIVEPEER_KEYSTORE_DIR=./.dev/keystore
# PAYMENT_DAEMON_MODE (gateway -> daemon):
#   mock — MockPaymentDaemonClient with deterministic faux payments
#   grpc — Real gRPC client against payment-daemon over its UDS socket
PAYMENT_DAEMON_MODE=grpc
PAYMENT_DAEMON_SOCKET=/var/run/livepeer/payer-daemon.sock
# REGISTRY_DAEMON_MODE (gateway -> daemon):
#   mock — MockRegistryClient with a fixed in-memory route set
#   grpc — Real gRPC client against service-registry-daemon
REGISTRY_DAEMON_MODE=grpc
REGISTRY_DAEMON_SOCKET=/var/run/livepeer/service-registry.sock
# REGISTRY_CACHE_TTL_SECONDS: in-process TTL for Select/SelectMany/list_*
# results from the registry. 0 disables caching.
REGISTRY_CACHE_TTL_SECONDS=60

# ---------------------------------------------------------------------------
# billing defaults
# ---------------------------------------------------------------------------
DEFAULT_INITIAL_CREDIT_WEI=0
DEFAULT_SPEND_PERIOD_SECONDS=86400
DEFAULT_SPEND_PERIOD_CAP_WEI=0
AUTO_REPLENISH_INCREMENT_WEI=0
# How often the scheduler scans for users below their per-user
# `auto_replenish_threshold_wei` and tops them up. Set to 0 to disable
# the job entirely (replenish becomes operator-topup-only). 300 = 5 min.
AUTO_REPLENISH_CHECK_INTERVAL_SECONDS=300

# ---------------------------------------------------------------------------
# ticket-mint reliability
# ---------------------------------------------------------------------------
IDEMPOTENCY_INFLIGHT_TIMEOUT_SECONDS=60
# Request-ID recovery of broker job outcomes. Set to 0 to disable.
JOB_RECONCILIATION_INTERVAL_SECONDS=60
# Operational deadline for unresolved jobs. Zero disables automatic full charge.
JOB_CONSERVATIVE_CHARGE_AFTER_SECONDS=0
# Slow safety-net lookup of broker-signed terminal session settlements.
# Set to 0 to disable. The customer SDK close path remains authoritative.
SESSION_RECONCILIATION_INTERVAL_SECONDS=60

# ---------------------------------------------------------------------------
# image tags used by docker-compose
# ---------------------------------------------------------------------------
OPEN_CLEARINGHOUSE_GATEWAY_TAG=dev
LIVEPEER_PAYER_DAEMON_TAG=v2.0.0
LIVEPEER_REGISTRY_DAEMON_TAG=v2.0.0
