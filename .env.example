# PymtHouse environment configuration.
#
# Copy this file to `.env` for local development. `.env` is git-ignored.
# Values marked "MUST CHANGE FOR PROD" are dev-only placeholders.

# ---------------------------------------------------------------------------
# application
# ---------------------------------------------------------------------------
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
PUBLIC_BASE_URL=http://localhost:8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# database
# ---------------------------------------------------------------------------
# docker compose uses the service name `db` as host
DATABASE_URL=postgresql+asyncpg://pymthouse:pymthouse-dev-password@db:5432/pymthouse

POSTGRES_DB=pymthouse
POSTGRES_USER=pymthouse
POSTGRES_PASSWORD=pymthouse-dev-password

# ---------------------------------------------------------------------------
# secrets — MUST CHANGE FOR PROD
# ---------------------------------------------------------------------------
API_KEY_HASH_PEPPER=dev-pepper-CHANGE-FOR-PROD
SESSION_SECRET=dev-session-secret-CHANGE-FOR-PROD
METRICS_TOKEN=dev-metrics-token-CHANGE-FOR-PROD
ADMIN_BOOTSTRAP_TOKEN=dev-admin-bootstrap-CHANGE-FOR-PROD

# ---------------------------------------------------------------------------
# OAuth (optional — deferred to a later phase)
# ---------------------------------------------------------------------------
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# email (optional — falls back to NullEmail in dev)
# ---------------------------------------------------------------------------
# RESEND_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@pymthouse.local
EMAIL_FROM_NAME=PymtHouse

# ---------------------------------------------------------------------------
# daemons — UDS paths inside the gateway container (shared volume)
# ---------------------------------------------------------------------------
PAYMENT_DAEMON_SOCKET=/var/run/livepeer/payer-daemon.sock
REGISTRY_DAEMON_SOCKET=/var/run/livepeer/service-registry.sock

# ---------------------------------------------------------------------------
# billing defaults
# ---------------------------------------------------------------------------
DEFAULT_INITIAL_CREDIT_WEI=0
DEFAULT_SPEND_PERIOD_SECONDS=86400
DEFAULT_SPEND_PERIOD_CAP_WEI=0
AUTO_REPLENISH_INCREMENT_WEI=0

# ---------------------------------------------------------------------------
# ticket-mint reliability
# ---------------------------------------------------------------------------
IDEMPOTENCY_INFLIGHT_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# image tags used by docker-compose
# ---------------------------------------------------------------------------
PYMTHOUSE_GATEWAY_TAG=dev
LIVEPEER_PAYER_DAEMON_TAG=v1.3.0
LIVEPEER_REGISTRY_DAEMON_TAG=v1.3.0
